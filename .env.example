# ── Database ─────────────────────────────────────────────
# Vercel: transaction pooler(6543) + connection_limit
# 상시 Node 호스트: session pooler(5432) + PG_POOL_MAX
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
PG_POOL_MAX="10"

# ── Auth ─────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="https://your-domain.example"

# ── Shared cache (optional, Upstash Redis / Vercel KV) ───
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Vercel KV를 쓸 경우 KV_REST_API_URL / KV_REST_API_TOKEN
